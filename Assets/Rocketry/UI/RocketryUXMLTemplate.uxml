<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="align-self: center; justify-content: flex-start; align-content: auto; width: 100%; flex-direction: row;">
        <ui:Label text="Score:" name="ScoreDisplay" style="-unity-font-style: bold; font-size: 20px; color: rgb(255, 255, 255); align-items: stretch;"/>
        <ui:ProgressBar value="100" title="Fuel" name="FuelDisplay" high-value="150" style="width: 25%; -unity-font-style: bold; font-size: 20px;"/>
    </ui:VisualElement>
</ui:UXML>
